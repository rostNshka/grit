{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "types": ["react", "react-dom", "node", "vite/client"],
    "paths": {
      "@/*": ["./src/*"]
    },
    "noEmit": true,
    "allowImportingTsExtensions": true
  },
  "include": ["src/**/*", "vite.config.ts"],
  "exclude": ["node_modules", "dist"]
}